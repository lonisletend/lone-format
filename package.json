{
  "name": "lone-format",
  "version": "0.14.0",
  "type": "module",
  "description": "A Vue 3 component library for formatting with tree-shaking support",
  "main": "./dist/lone-format.umd.cjs",
  "module": "./dist/lone-format.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lone-format.js",
      "require": "./dist/lone-format.umd.cjs"
    },
    "./json-format": {
      "types": "./dist/components/JsonFormat/index.d.ts",
      "import": "./dist/components/JsonFormat/index.js"
    },
    "./xml-format": {
      "types": "./dist/components/XmlFormat/index.d.ts",
      "import": "./dist/components/XmlFormat/index.js"
    },
    "./sql-format": {
      "types": "./dist/components/SqlFormat/index.d.ts",
      "import": "./dist/components/SqlFormat/index.js"
    },
    "./style.css": "./dist/lone-format.css",
    "./lone-format.css": "./dist/lone-format.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build --mode lib-es && vite build --mode lib-umd",
    "build:lib:full": "vue-tsc -b && vite build --mode lib-es && vite build --mode lib-umd",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "publish:lib": "npm publish --access public",
    "publish:dry": "npm publish --dry-run",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "fast-xml-parser": "^5.3.0",
    "jsonpath-plus": "^10.3.0",
    "sql-formatter": "^15.7.0",
    "xpath": "^0.0.34"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/xmldom": "^0.1.34",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "glob": "^11.0.3",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.3",
    "vue-tsc": "^2.2.12"
  }
}
